@using ViewsExaple.Models
@model Person
<!DOCTYPE html>
<html>
<head>
    <title>Person Details</title>
    <meta charset="utf-8" />
    <link href="~/StyleSheet.css" rel="stylesheet" />
</head>
<body>
    <div class="page-content">
        <h1>Person Details</h1>
        <div class="box">
        <h3>@Model.Name</h3>
        <table class="table">
            <tbody>
                <tr>
                    <td>
                        Gender
                    </td>
                    <td>
                        @Model.PersonGender
                    </td>
                </tr>
                <tr>
                    <td>
                        Date of Birth
                    </td>
                    <td>
                        @Model.BirthDate?.ToString("dd/MM/yyyy")
                    </td>
                </tr>
            </tbody>
        </table>
        </div>
        <a href="/home">Back to person</a>
    </div>
</body>
</html>
